# ── Refinitiv / LSEG ──────────────────────────────────────────────────────────
# Required for live price data, news, and paper trading.
# Get credentials at: https://developers.lseg.com/en/api-catalog/refinitiv-data-platform
#
# Desktop session (Eikon / LSEG Workspace app must be running):
LSEG_APP_KEY=your_lseg_app_key_here

# Platform session (direct API — needed for server/cron runs without desktop app):
# LSEG_APP_KEY=your_lseg_app_key_here   # same key as above
LSEG_USERNAME=your_lseg_machine_username_here
LSEG_PASSWORD=your_lseg_machine_password_here

# ── FRED ──────────────────────────────────────────────────────────────────────
# Required for macro indicators (yield curve, VIX, etc.).
# Free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── Report settimanale via Gmail ───────────────────────────────────────────────
# Il runner spedisce il report ogni venerdì se queste variabili sono presenti.
# Usa un Gmail App Password (NON la password normale):
#   Google Account → Sicurezza → Verifica in 2 passaggi → Password per le app
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Destinatari separati da virgola
REPORT_RECIPIENTS=email1@example.com,email2@example.com

# ── SMTP generico (agent ReportAgent — alternativa a Gmail) ───────────────────
# Usato da jeanclaude/agents/report.py se si preferisce un server SMTP custom.
# Lasciare vuoti per disabilitare (il mailer Gmail sopra ha precedenza).
SMTP_USER=
SMTP_PASSWORD=
